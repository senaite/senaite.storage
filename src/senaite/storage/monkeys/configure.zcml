<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:monkey="http://namespaces.plone.org/monkey"
    i18n_domain="senaite.storage">

  <monkey:patch
    description="The date the Sample was stored"
    class="bika.lims.content.analysisrequest.AnalysisRequest"
    original="getDateStored"
    ignoreOriginal="True"
    replacement=".content.analysisrequest.getDateStored" />

  <monkey:patch
    description="The container ID where the sample is stored"
    class="bika.lims.content.analysisrequest.AnalysisRequest"
    original="getSamplesContainerID"
    ignoreOriginal="True"
    replacement=".content.analysisrequest.getSamplesContainerID" />

  <monkey:patch
    description="The container URL where the sample is stored"
    class="bika.lims.content.analysisrequest.AnalysisRequest"
    original="getSamplesContainerURL"
    ignoreOriginal="True"
    replacement=".content.analysisrequest.getSamplesContainerURL" />

  <monkey:patch
    description="The retention period for stored sample"
    class="bika.lims.content.analysisrequest.AnalysisRequest"
    original="getStorageRetentionPeriod"
    ignoreOriginal="True"
    replacement=".content.analysisrequest.getStorageRetentionPeriod" />

  <monkey:patch
    description="Set the retention period for stored sample"
    class="bika.lims.content.analysisrequest.AnalysisRequest"
    original="setStorageRetentionPeriod"
    ignoreOriginal="True"
    replacement=".content.analysisrequest.setStorageRetentionPeriod" />

  <monkey:patch
    description="Default retention period computed from rules"
    class="bika.lims.content.analysisrequest.AnalysisRequest"
    original="getDefaultStorageRetentionPeriod"
    ignoreOriginal="True"
    replacement=".content.analysisrequest.getDefaultStorageRetentionPeriod" />

  <monkey:patch
    description="Storage expiration date of stored sample"
    class="bika.lims.content.analysisrequest.AnalysisRequest"
    original="getStorageRetentionExpiryDate"
    ignoreOriginal="True"
    replacement=".content.analysisrequest.getStorageRetentionExpiryDate" />

</configure>
